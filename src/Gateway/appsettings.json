{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Gateway.Auth": "Debug"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32BytesLong!",
    "Issuer": "GraphQLGateway",
    "Audience": "GraphQLGatewayClients",
    "ExpirationMinutes": 60
  },
  "Authorization": {
    "Policies": {
      "AdminOnly": {
        "Roles": ["Admin"]
      },
      "AdminOrUser": {
        "Roles": ["Admin", "User"]
      },
      "Authenticated": {
        "RequireAuthentication": true
      },
      "CanViewPrices": {
        "Roles": ["Admin", "User"]
      },
      "CanViewOrders": {
        "Roles": ["Admin", "User"]
      },
      "CanPlaceOrders": {
        "Roles": ["Admin", "User"]
      },
      "CanViewReviews": {
        "RequireAuthentication": true
      },
      "PremiumUser": {
        "Roles": ["User"],
        "Claims": [
          {
            "Type": "subscription",
            "Values": ["premium", "enterprise"]
          }
        ]
      }
    }
  },
  "FieldAuthorization": {
    "Fields": {
      "query.orders": "CanViewOrders",
      "query.reviews": "CanViewReviews",
      "query.review": "CanViewReviews",
      "mutation.placeOrder": "CanPlaceOrders"
    }
  },
  "CostLimits": {
    "WindowSeconds": 60,
    "DefaultMaxCost": 1000,
    "AnonymousMaxCost": 100,
    "RoleMultipliers": {
      "Admin": 10.0,
      "User": 2.0,
      "Viewer": 1.0
    },
    "CostPerField": 1,
    "CostPerDepthLevel": 2,
    "MutationMultiplier": 5.0,
    "ListFieldMultiplier": 10.0,
    "MaxDepth": 10,
    "MaxFields": 100,
    "MaxHistoryEntries": 50
  },
  "CostPricing": {
    "CostToEuroMultiplier": 0.001,
    "TierPricing": {
      "Free": {
        "MonthlyFee": 0.0,
        "CostMultiplier": 0.0
      },
      "Normal": {
        "MonthlyFee": 29.99,
        "CostMultiplier": 0.001
      },
      "Premium": {
        "MonthlyFee": 99.99,
        "CostMultiplier": 0.0005
      },
      "Enterprise": {
        "MonthlyFee": 499.99,
        "CostMultiplier": 0.0002
      }
    }
  }
}
